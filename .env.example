# When true, POST /api/auth/otp/send returns the OTP in the response body so a
# developer can log in without an SMS gateway. Never enable this on a deployed
# environment: anyone who knows a registered mobile number could request a code,
# read it from the response and sign in as that user.
EXPOSE_OTP=false
OTP_COOLDOWN_SEC=
OTP_MAX_PER_WINDOW=
OTP_RATE_LIMIT_MAX=
OTP_RATE_LIMIT_WINDOW_MS=
OTP_TTL_SEC=
OTP_WINDOW_MIN=
