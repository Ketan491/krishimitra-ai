node_modules/
data.json
.env
frontend/dist/
*.tsbuildinfo
backend/uploads/*
!backend/uploads/.gitkeep
*.log
backend/tests/.tmp-trace.json
frontend/src/lib/i18n-scratch-*.json

# Per-process data files written by the test suites. Each test run creates
# backend/data.unit-<pid>.json and these were being committed by accident.
backend/data.unit-*.json

# Bun lockfiles are gone: this project installs and builds with npm only.
# Keeping them around makes Render provision Bun and diverge from the documented
# npm sequence.
bun.lock
bun.lockb

# package-lock.json IS committed, for both backend and frontend, so that Render
# can use `npm ci` for a reproducible install. (Verified: npm records the
# optional native bindings for every platform in the lockfile, so a lockfile
# written on Windows still installs the Linux binaries correctly.)
