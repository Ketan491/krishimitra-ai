# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.
# A working .env ships with the project so the demo runs out of the box;
# change every secret below before deploying anywhere real.

# ---- Server ----
PORT=5000

# ---- Auth (JWT) ----
# Used to sign login tokens. Change to a long random string before deploying.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Default admin account (bootstrap from env — change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- CORS ----
# Comma-separated list of allowed browser origins for the React dev server.
# The built frontend is served by this same backend, so it needs no origin.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---- Rate limiting ----
# Login endpoint: max requests per window per IP.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
# General API rate limit (per IP).
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# ---- Storage ----
# Where uploaded images live for the local demo. Swap for S3/Cloudinary by
# replacing services/storage.js — the routes only ever see /uploads URLs.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=3

# ---- Data store ----
# JSON-file path for the demo datastore (isolated behind db.js — swap the
# implementation for SQLite/MySQL without touching route code).
DB_FILE=./data.json

# ---- Optional integrations (future scope, currently mocked) ----
# Plug in a real weather provider key and set WEATHER_PROVIDER=openweather
# to replace the deterministic mock in knowledge/weather.js.
WEATHER_PROVIDER=mock
# OPENWEATHER_API_KEY=
# OPENWEATHER_UNITS=metric